# 构建两个前端并把产物交给 nginx：用户端在根路径，管理端在 /admin/

# ---------- 用户端 ----------
FROM node:22-alpine AS user-build
WORKDIR /build
COPY frontend/user/package.json frontend/user/package-lock.json ./
RUN npm ci
COPY frontend/user/ ./
RUN npm run build

# ---------- 管理端 ----------
FROM node:22-alpine AS admin-build
WORKDIR /build
COPY frontend/admin/package.json frontend/admin/package-lock.json ./
RUN npm ci
COPY frontend/admin/ ./
RUN npm run build

# ---------- 运行 ----------
FROM nginx:1.28-alpine

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=user-build /build/dist /usr/share/nginx/html
COPY --from=admin-build /build/dist /usr/share/nginx/html/admin

EXPOSE 80